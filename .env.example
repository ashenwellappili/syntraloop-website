# ==============================================================================
# SyntraLoop - Environment Configuration Template
# ==============================================================================
# Configure SMTP settings for server-side direct email delivery (Contact & Assessment forms)

# SMTP Server Host (e.g., smtp.gmail.com for Google Workspace / Gmail)
SMTP_HOST=smtp.gmail.com

# SMTP Server Port (465 for SSL, 587 for TLS)
SMTP_PORT=465

# Set to true for port 465 (SSL), false for port 587 (TLS/STARTTLS)
SMTP_SECURE=true

# Sender / Auth Email Address
SMTP_USER=syntraloop.contact@gmail.com

# Google App Password (16-character password generated from Google Account > Security > 2-Step Verification > App passwords)
# NOTE: Do NOT use your standard account password. Generate an App Password.
SMTP_PASS=your-google-app-password

# Email address that receives submitted project assessments and customer inquiries
CONTACT_RECEIVER_EMAIL=syntraloop.contact@gmail.com
